  <script>
const $=id=>document.getElementById(id);
document.querySelectorAll('[data-go]').forEach(b=>b.addEventListener('click',()=>{document.querySelectorAll('main>section').forEach(s=>s.classList.toggle('hidden',s.id!==b.dataset.go));document.querySelectorAll('.nav-item').forEach(n=>{const active=n.dataset.go===b.dataset.go;n.classList.toggle('active',active);if(active)n.setAttribute('aria-current','page');else n.removeAttribute('aria-current')})}));
document.querySelectorAll('[data-quiz-menu]').forEach(b=>b.addEventListener('click',()=>{stage('multiple-stage');quizView('quiz-menu')}));
const answers=[0,1,2,0,1,2,0,1,2,0],colors=['red','blue','green','yellow'],fallbacks=['Merah','Biru','Hijau','Kuning'],zoneColors=['#b91c1c','#1d4ed8','#047857','#b45309'];
const questions=[...document.querySelectorAll('.question')];let players=[],panels=[],q=0,turn=0,multiplayer=false,roundDone=false,matchingChecked=false,selectedCard=null;
function quizView(id){['quiz-menu','setup','game','results'].forEach(v=>$(v).classList.toggle('hidden',v!==id))}
function stage(id){['multiple-stage','matching-stage','short-stage'].forEach(v=>$(v).classList.toggle('hidden',v!==id))}
$('solo').onclick=()=>{multiplayer=false;players=[{name:'Latihan Mandiri',score:0,color:'green'}];start()};
$('multi').onclick=()=>quizView('setup');
$('setup').onsubmit=e=>{e.preventDefault();multiplayer=true;players=colors.map((color,i)=>({name:$('p'+i).value.trim()||fallbacks[i],color,score:0}));start()};
function start(){q=0;turn=0;panels=[];$('player-list').replaceChildren();players.forEach((p,i)=>{const panel=$('player-template').content.firstElementChild.cloneNode(true);panel.style.setProperty('--zone',multiplayer?zoneColors[i]:'#047857');panel.querySelector('[data-template-id="player-name"]').textContent=p.name;panel.querySelectorAll('[data-choice]').forEach(b=>b.onclick=()=>choose(i,Number(b.dataset.choice)));panels.push(panel);$('player-list').append(panel)});stage('multiple-stage');quizView('game');renderQuestion()}
function status(panel,state){['waiting','locked','right','wrong'].forEach(s=>panel.querySelector('.'+s).classList.toggle('hidden',s!==state))}
function renderQuestion(){roundDone=false;$('next').disabled=true;questions.forEach((node,i)=>{node.classList.toggle('hidden',i!==q);node.querySelectorAll('.option').forEach(o=>o.classList.remove('correct'))});players.forEach((p,i)=>{p.choice=null;const panel=panels[i];status(panel,'waiting');panel.querySelector('[data-template-id="player-score"]').textContent=p.score+' poin';panel.querySelectorAll('[data-choice]').forEach(b=>{b.disabled=false;b.classList.remove('chosen');b.setAttribute('aria-pressed','false')})});$('progress').textContent='Soal '+(q+1)+' / 10 • Tahap 1 dari 3';updateCount()}
function updateCount(){$('answered-count').textContent=players.filter(p=>p.choice!==null).length+' / '+players.length+' pemain sudah menjawab'}
function choose(i,choice){if(roundDone||players[i].choice!==null)return;players[i].choice=choice;panels[i].querySelectorAll('[data-choice]').forEach(b=>{b.disabled=true;const chosen=Number(b.dataset.choice)===choice;b.classList.toggle('chosen',chosen);b.setAttribute('aria-pressed',String(chosen))});status(panels[i],'locked');updateCount();if(players.every(p=>p.choice!==null)){roundDone=true;questions[q].querySelectorAll('.option')[answers[q]].classList.add('correct');players.forEach((p,j)=>{const right=p.choice===answers[q];if(right)p.score+=10;status(panels[j],right?'right':'wrong');panels[j].querySelector('[data-template-id="player-score"]').textContent=p.score+' poin'});$('next').disabled=false}}
$('next').onclick=()=>{if(!roundDone)return;if(++q===questions.length)beginMatching();else renderQuestion()};
const bank=$('card-bank'),cards=[...document.querySelectorAll('[data-match]')],zones=[...document.querySelectorAll('.drop-zone')];
function beginMatching(){resetMatching();$('match-turn').textContent=multiplayer?'Giliran '+players[turn].name+' • Pemain '+(turn+1)+' dari 4':'Tahap 2 dari 3';stage('matching-stage')}
function selectCard(card){if(matchingChecked)return;selectedCard=card;cards.forEach(c=>c.classList.toggle('selected',c===card))}
function place(card,zone){if(matchingChecked||!card)return;const occupant=zone.querySelector('[data-match]');if(occupant&&occupant!==card)bank.append(occupant);zone.append(card);selectedCard=null;cards.forEach(c=>c.classList.remove('selected'));zones.forEach(z=>z.classList.remove('over'));$('match-feedback').textContent=''}
cards.forEach(c=>{c.addEventListener('click',e=>{e.stopPropagation();selectCard(c)});c.addEventListener('dragstart',e=>{if(matchingChecked){e.preventDefault();return}selectCard(c);e.dataTransfer.setData('text/plain',c.dataset.match);e.dataTransfer.effectAllowed='move'})});
zones.forEach(z=>{z.addEventListener('click',()=>{if(selectedCard)place(selectedCard,z);else if(z.querySelector('[data-match]'))selectCard(z.querySelector('[data-match]'))});z.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();if(selectedCard)place(selectedCard,z);else if(z.querySelector('[data-match]'))selectCard(z.querySelector('[data-match]'))}});z.addEventListener('dragover',e=>{if(!matchingChecked){e.preventDefault();z.classList.add('over')}});z.addEventListener('dragleave',()=>z.classList.remove('over'));z.addEventListener('drop',e=>{e.preventDefault();place(cards.find(c=>c.dataset.match===e.dataTransfer.getData('text/plain')),z)})});
bank.addEventListener('click',e=>{if(e.target===bank&&selectedCard){bank.append(selectedCard);selectedCard.classList.remove('selected');selectedCard=null}});bank.addEventListener('dragover',e=>{if(!matchingChecked)e.preventDefault()});bank.addEventListener('drop',e=>{e.preventDefault();if(matchingChecked)return;const card=cards.find(c=>c.dataset.match===e.dataTransfer.getData('text/plain'));if(card){bank.append(card);cards.forEach(c=>c.classList.remove('selected'));selectedCard=null}});
function resetMatching(){matchingChecked=false;selectedCard=null;cards.forEach(c=>{bank.append(c);c.classList.remove('selected')});zones.forEach(z=>z.classList.remove('good','bad','over'));$('match-feedback').textContent='';$('check-match').disabled=false;$('match-next').classList.add('hidden')}
$('check-match').onclick=()=>{if(zones.some(z=>!z.querySelector('[data-match]'))){$('match-feedback').textContent='Isi keempat kotak sebelum memeriksa jawaban.';return}matchingChecked=true;let correct=0;zones.forEach(z=>{const right=z.querySelector('[data-match]').dataset.match===z.dataset.target;z.classList.add(right?'good':'bad');if(right)correct++});players[turn].score+=correct*10;$('match-feedback').textContent=correct+' dari 4 pasangan benar. +'+correct*10+' poin untuk '+players[turn].name+'.';$('check-match').disabled=true;$('match-next').classList.remove('hidden')};
$('match-next').onclick=()=>{const form=$('short-stage');form.reset();form.querySelectorAll('input').forEach(input=>{input.disabled=false;input.style.borderColor='';input.removeAttribute('aria-invalid')});$('short-feedback').textContent='';form.querySelector('[type="submit"]').classList.remove('hidden');$('short-next').classList.add('hidden');$('short-turn').textContent=multiplayer?'Giliran '+players[turn].name+' • Pemain '+(turn+1)+' dari 4':'Tahap 3 dari 3';stage('short-stage')};
const normalized=s=>String(s||'').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/[^a-z]/g,''),valid=[['asysyakur','assyakur','asyshakur','assyakur'],['alhalim','halim'],['alhakim','hakim'],['alwadud','wadud']];
$('short-stage').onsubmit=e=>{e.preventDefault();let correct=0;for(let i=0;i<4;i++){const input=$('short-'+i),answer=normalized(input.value),ok=answer.length>0&&valid[i].some(v=>answer===normalized(v));input.style.borderColor=ok?'#059669':'#be123c';input.setAttribute('aria-invalid',String(!ok));input.disabled=true;if(ok)correct++}players[turn].score+=correct*10;$('short-feedback').textContent=correct+' dari 4 isian benar. +'+correct*10+' poin untuk '+players[turn].name+'.';e.currentTarget.querySelector('[type="submit"]').classList.add('hidden');$('short-next').classList.remove('hidden')};
$('short-next').onclick=()=>{if(++turn<players.length)beginMatching();else finish()};
function finish(){quizView('results');$('result-note').textContent='Pilihan ganda + drag and drop + isian singkat • maksimal 180 poin per pemain';$('result-list').replaceChildren();players.forEach(player=>{const row=$('result-template').content.firstElementChild.cloneNode(true);row.querySelector('[data-template-id="result-value"]').textContent=player.name+' — '+player.score+' / 180 poin';row.querySelector('.save').onclick=e=>savePlayer(player,e.currentTarget,row);$('result-list').append(row)})}
$('restart').onclick=()=>quizView('quiz-menu');
let backendRecords=[],ready=false,timer,generation=0;const rowMap=new Map();
function renderScores(){$('empty').classList.toggle('hidden',backendRecords.length!==0);$('capacity').textContent=backendRecords.length>=900?backendRecords.length+' / 999 skor tersimpan':'';const ranked=backendRecords.slice().sort((a,b)=>Number(b.score)-Number(a.score)).slice(0,20),ids=new Set(ranked.map(r=>r.__backendId));rowMap.forEach((node,id)=>{if(!ids.has(id)){node.remove();rowMap.delete(id)}});ranked.forEach((r,i)=>{let row=rowMap.get(r.__backendId);if(!row){row=$('score-template').content.firstElementChild.cloneNode(true);row.dataset.recordId=r.__backendId;rowMap.set(r.__backendId,row)}const name=row.querySelector('[data-template-id="score-name"]'),value=row.querySelector('[data-template-id="score-value"]'),nt=(i+1)+'. '+(r.player_name||'Pemain'),vt=Number(r.score||0)+' poin';if(name.textContent!==nt)name.textContent=nt;if(value.textContent!==vt)value.textContent=vt;const current=$('score-list').children[i];if(current!==row)$('score-list').insertBefore(row,current||null)})}
function loadError(){ready=false;$('loading').classList.add('hidden');$('load-error').classList.remove('hidden');$('retry').classList.remove('hidden')}
async function initialize(){const g=++generation;ready=false;clearTimeout(timer);$('loading').classList.remove('hidden');$('load-error').classList.add('hidden');$('retry').classList.add('hidden');timer=setTimeout(()=>{if(g===generation)loadError()},8000);try{const result=await window.dataSdk.init({onDataChanged(data){if(g!==generation)return;clearTimeout(timer);ready=true;backendRecords=data;$('loading').classList.add('hidden');$('load-error').classList.add('hidden');$('retry').classList.add('hidden');renderScores()}});if(!result.isOk&&g===generation){clearTimeout(timer);loadError()}}catch{if(g===generation){clearTimeout(timer);loadError()}}}
let writeChain=Promise.resolve(),lastWrite=0;
async function savePlayer(player,button,row){row.querySelector('.error').classList.add('hidden');row.querySelector('.limit').classList.add('hidden');if(!ready){row.querySelector('.error').classList.remove('hidden');return}if(backendRecords.length>=999){row.querySelector('.limit').classList.remove('hidden');return}button.disabled=true;row.querySelector('.saving').classList.remove('hidden');let success=false;try{const work=writeChain.catch(()=>{}).then(async()=>{const delay=Math.max(0,500-(Date.now()-lastWrite));if(delay)await new Promise(r=>setTimeout(r,delay));if(backendRecords.length>=999){row.querySelector('.limit').classList.remove('hidden');return}lastWrite=Date.now();const result=await window.dataSdk.create({player_name:player.name,zone_color:player.color,score:player.score,quiz_date:new Date().toISOString()});if(result.isOk){success=true;row.querySelector('.saved').classList.remove('hidden')}else row.querySelector('.error').classList.remove('hidden')});writeChain=work;await work}catch{row.querySelector('.error').classList.remove('hidden')}finally{button.disabled=false;button.hidden=success;row.querySelector('.saving').classList.add('hidden')}}
$('retry').onclick=initialize;initialize();
</script>
